<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

    <PropertyGroup>
        <Version>1.1.0.3</Version>
        <Description>Pop open a cold one while the tedious parts of exploration is handled by your good friend cousin robby.</Description>
        <PackageProjectUrl>https://github.com/goatcorp/ExplorersIcebox</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>true</IsPackable>
        <RootNamespace>ExplorersIcebox</RootNamespace>
        <TargetFramework>net10.0-windows8.0</TargetFramework>
        <NoWarn>CS8618; CS8625; CS8629;</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="ExplorersIcebox.json"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="YamlDotNet" Version="18.0.0" />
        <PackageReference Include="ECommons" Version="3.2.1" />
        <PackageReference Include="Pictomancy" Version="1.0.9"/>
        <PackageReference Update="DotNet.ReproducibleBuilds" Version="2.0.2" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Routes\CustomRoutes.yaml"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Update="DalamudPackager" Version="15.0.0"/>
    </ItemGroup>

</Project>
